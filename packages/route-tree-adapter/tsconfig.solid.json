{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.solid.tsbuildinfo",
    // Solid compiles JSX to its own reactive calls, not React.createElement.
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["src/solid"],
  "references": [{ "path": "./tsconfig.core.json" }]
}
