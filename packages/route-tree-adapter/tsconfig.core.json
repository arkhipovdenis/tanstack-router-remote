{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A referenced project must emit. This one only emits the declarations the
    // react/solid projects type-check against; the shipped dist/ is built by
    // rslib, so this output goes to the cache.
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "outDir": "node_modules/.cache/tsc-core",
    "rootDir": "src",
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.core.tsbuildinfo"
  },
  "include": ["src/index.ts", "src/core"]
}
