{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A referenced project must emit; rslib overrides outDir when it builds
    // dist/, so this default only feeds the react/solid/vue projects.
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "node_modules/.cache/tsc-core",
    // rslib emits the shipped declarations into dist/; outDir above only holds
    // the project-reference build info the framework projects consume.
    "declarationDir": "dist",
    "tsBuildInfoFile": "node_modules/.cache/tsc-core.tsbuildinfo"
  },
  "include": ["src/index.ts", "src/core"]
}
