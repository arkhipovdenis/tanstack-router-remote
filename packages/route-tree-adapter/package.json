{
  "name": "tanstack-router-remote",
  "version": "0.1.0-alpha.0",
  "description": "Route-tree attachment bridge for TanStack React Router microfrontends.",
  "keywords": [
    "tanstack",
    "react-router",
    "microfrontend",
    "module-federation",
    "route-tree",
    "rspack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkhipovdenis/tanstack-router-remote.git",
    "directory": "packages/route-tree-adapter"
  },
  "homepage": "https://github.com/arkhipovdenis/tanstack-router-remote#readme",
  "bugs": {
    "url": "https://github.com/arkhipovdenis/tanstack-router-remote/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "tag": "alpha"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.168.18",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rslib/core": "^0.19.0",
    "@tanstack/react-router": "catalog:",
    "@tanstack/router-core": "1.171.15",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
