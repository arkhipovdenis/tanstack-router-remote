{
  "name": "tanstack-router-remote-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm run build:packages && pnpm run build:examples",
    "build:packages": "pnpm --filter './packages/**' build",
    "build:examples": "pnpm --filter './examples/**' build",
    "dev": "pnpm run build:packages && pnpm --filter './examples/**' --parallel dev",
    "dev:example:module-federation": "pnpm run build:packages && pnpm --filter './examples/module-federation/**' --parallel dev",
    "dev:example:native-import": "pnpm run build:packages && pnpm --filter './examples/native-import/**' --parallel dev",
    "dev:example:file-routing": "pnpm run build:packages && pnpm --filter @tanstack-router-remote/example-native-import-remote build && pnpm --filter './examples/file-routing/**' --parallel dev",
    "dev:example:file-routing:physical": "pnpm run build:packages && pnpm --filter @tanstack-router-remote/example-native-import-remote build && pnpm --filter @tanstack-router-remote/example-file-routing dev",
    "dev:example:file-routing:virtual": "pnpm run build:packages && pnpm --filter @tanstack-router-remote/example-native-import-remote build && pnpm --filter @tanstack-router-remote/example-file-routing-virtual dev",
    "preview": "pnpm run build && pnpm --filter './examples/**' --parallel preview",
    "preview:example:module-federation": "pnpm run build && pnpm --filter './examples/module-federation/**' --parallel preview",
    "preview:example:native-import": "pnpm run build && pnpm --filter './examples/native-import/**' --parallel preview",
    "preview:example:file-routing": "pnpm run build && pnpm --filter './examples/file-routing/**' --parallel preview",
    "typecheck": "tsc --noEmit && pnpm --filter @tanstack-router-remote/example-native-import-remote build && pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check .",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tanstack/react-router": "catalog:",
    "@tanstack/router-generator": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^10.0.4",
    "eslint": "^9.22.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.26.0",
    "vitest": "3.2.7"
  }
}
