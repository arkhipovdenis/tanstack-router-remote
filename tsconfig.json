{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  // Solid and Vue sources are checked by the package's own projects
  // (`pnpm -r typecheck`), not by this React-flavoured root project that also
  // covers the test suite.
  "include": ["packages/route-tree-adapter/src", "tests", "vitest.config.ts"],
  "exclude": [
    "packages/route-tree-adapter/src/solid",
    "packages/route-tree-adapter/src/vue"
  ]
}
