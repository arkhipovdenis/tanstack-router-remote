{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  // React-flavoured: it carries `jsx: react-jsx` from the base config. The
  // Solid and Vue suites compile under their own JSX settings and are checked
  // by tsconfig.solid.json / tsconfig.vue.json instead.
  "include": ["packages/route-tree-adapter/src", "tests", "vitest.config.ts"],
  "exclude": [
    "packages/route-tree-adapter/src/solid",
    "packages/route-tree-adapter/src/vue",
    "tests/**/solid-*",
    "tests/**/vue-*"
  ]
}
