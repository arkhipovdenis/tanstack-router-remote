{
  "name": "@tanstack-router-remote/example-cross-vue-remote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./routeTree": {
      "types": "./dist/routeTree.d.ts",
      "import": "./dist/routeTree.js"
    },
    "./nestedTree": {
      "types": "./dist/nestedTree.d.ts",
      "import": "./dist/nestedTree.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && rslib build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/vue-router": ">=1.168.18",
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rsbuild/plugin-babel": "1.2.1",
    "@rsbuild/plugin-vue-jsx": "2.0.1",
    "@rslib/core": "^0.19.0",
    "@tanstack/vue-router": "catalog:",
    "@vue/babel-plugin-jsx": "3.0.0",
    "vue": "catalog:"
  }
}
